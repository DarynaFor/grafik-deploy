# ─────────────────────────────────────────────────────────────────────────────
# Наш собственный веб-сервер. Ради него и переезжаем на docker-compose.
#
# Timeweb 07.08.2026 ответил прямо: «конфигурировать веб-сервер в App Platform
# нельзя, но можно развернуть приложение через docker-compose и настроить свой».
# Вот он. Домен и сертификат остаются за платформой — порты 80 и 443 у неё
# зарезервированы, она принимает HTTPS снаружи и ходит к нам простым HTTP
# внутрь. Поэтому здесь :8080 и никакого TLS: он уже сделан до нас.
#
# ⚠ ИМЕНА МАТЧЕРОВ ЗДЕСЬ ТОЛЬКО ЛАТИНИЦЕЙ. Комментарии — по-русски, как везде,
#   но всё, что читает не человек, а программа, пишем ASCII: за один день 11.08
#   кириллическое имя переменной положило скрипт пять раз подряд.
#
# ПРОВЕРЯТЬ ЭТОТ ФАЙЛ ПЕРЕД КАЖДОЙ ПРАВКОЙ — на маке для этого всё есть:
#   caddy validate --config deploy/Caddyfile --adapter caddyfile
#   ./scripts/check-caddy.sh          # поднимает и проверяет поведение целиком
# Версия Caddy на маке и в Dockerfile должна совпадать (2.11), иначе проверяем
# не то, что поедет.
#
# ЗАЧЕМ ВСЁ ЭТО (замерено 11.08, а не на глаз):
#   • холодный заход весит 972 КБ и НЕ сжимается — Timeweb этого не умел.
#     Те же файлы со сжатием — 274 КБ, в 3,5 раза меньше;
#   • и это не про «первый раз»: версия в адресе меняется на каждом выпуске, а
#     их бывает по десятку в день (159→169 за двое суток). Значит 972 КБ люди
#     качают заново после каждой правки, и service worker тут не помогает —
#     у файла новый адрес. Сжатие же работает всегда;
#   • у людей в клинике плохой канал: страница поднималась 10–15 секунд —
#     это не жалобы, это записи в error_log за 10.08.
# ─────────────────────────────────────────────────────────────────────────────

:8080 {
	root * /srv

	# ── 1. СЖАТИЕ. Ради этой строки всё и затевалось.
	#    zstd первым: он новее и жмёт лучше, браузеры без него возьмут gzip.
	encode zstd gzip

	# ── 2. ЗАКРЫВАЕМ ВСЁ, ЧТО НАЧИНАЕТСЯ С ТОЧКИ.
	#    11.08.2026 обнаружено: https://grafik.one/.git/config отдавался кодом
	#    200 и содержал ЖИВОЙ токен GitHub (ghu_…, право записи) от репозитория,
	#    который платформа выкатывает автоматически. Проверено в тот же день —
	#    GitHub его принимал. То есть любой прохожий мог подменить программу
	#    всей клинике. Каталог .git отдавался целиком: index, refs, logs, объекты.
	#
	#    В образ .git не попадает вовсе (Dockerfile копирует файлы поимённо,
	#    плюс .dockerignore), так что это ВТОРОЙ рубеж. Заодно закрыты .env,
	#    .DS_Store и всё прочее точечное.
	@dotfiles path_regexp dotfiles ^/\.
	respond @dotfiles 404

	# ── 3. КЭШИРОВАНИЕ.
	#    Адреса с версией (app.js?v=169) можно держать вечно: меняется версия —
	#    меняется адрес. Это снимает лишний вопрос «не изменилось ли» по каждому
	#    файлу за заход, а на плохом канале один такой вопрос стоит секунды.
	#
	#    ⚠ ВНИМАНИЕ, ЗДЕСЬ ЗАРЫТА СТАРАЯ МИНА. В заметках по проекту записано
	#    прямым текстом: «щойно хтось додасть immutable-кеш у Caddy, новий app.js
	#    спарується із ЗАМОРОЖЕНИМ старим store.js → поломка в постійних
	#    користувачів». Причина: версий не две, а ТРИ — app.js и styles.css в
	#    index.html плюс `import … from './store.js?v=N'` ВНУТРИ app.js. Пока
	#    сервер отдавал всё через ETag, рассинхрон прощался. С immutable — уже нет.
	#
	#    Поэтому immutable включается только вместе с воротами в publish.sh,
	#    которые этот рассинхрон ловят ДО выкатки:
	#      • ворота 3б — версия store.js в modulepreload обязана совпадать с той,
	#        что в import внутри app.js;
	#      • ворота 4 — если app.js, store.js или styles.css изменился, а номер
	#        остался прежним, публикация останавливается.
	#    Обе на месте и проверены (в том числе на «ловят ли плохое»). Убирать
	#    их, оставив эту строку, нельзя — вернётся ровно описанная поломка.
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	#    А саму страницу — НИКОГДА не кэшировать. В index.html живёт проверка
	#    свежести, которой выкатки доходят до людей: закэшируй её — и человек
	#    останется на старой версии навсегда.
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"

	#    Эти три без версии в адресе. config.js — адрес базы; sw.js управляет
	#    кэшем у всех, и сломанный иначе не заменить; manifest.json тоже.
	header /config.js Cache-Control "no-cache"
	header /sw.js Cache-Control "no-cache"
	header /manifest.json Cache-Control "no-cache"

	# ── 4. Мелочи безопасности.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# ── 5. НАСТОЯЩИЙ 404 вместо страницы.
	#    Раньше сервер отдавал index.html на любой несуществующий путь И С КОДОМ
	#    200 — пропавший файл выглядел как удачно скачанный, и его можно было
	#    положить в кэш вместо кода (защита от этого стоит в sw.js).
	#    Нам подмена не нужна: адреса экранов у нас в решётке (#/raschet/2026-07),
	#    до сервера они не доходят, подставлять страницу незачем.
	file_server

	log {
		output stdout
		format console
		# INFO, а не ERROR: 404 в логе платформы — единственный способ увидеть,
		# что после выкатки пропал файл.
		level INFO
	}
}
