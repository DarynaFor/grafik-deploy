# Что НЕ должно попасть в образ ни при каких обстоятельствах.
#
# .git здесь первым и не случайно: именно из-за него 11.08.2026 наружу утёк
# живой токен GitHub с правом записи (https://grafik.one/.git/config отдавался
# кодом 200). Dockerfile и так копирует файлы поимённо, это второй рубеж.
.git
.git/**
.gitignore
.env
.env.*
*.env

# Скрипты установки из времён своего сервера — сайту они не нужны.
install.sh
update.sh

# Сборочные файлы: внутрь самого образа им незачем.
Dockerfile
docker-compose.yml
.dockerignore

# Мусор системы
.DS_Store
**/.DS_Store
*.log
*.sql
*.gpg
