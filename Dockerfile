# ─────────────────────────────────────────────────────────────────────────────
# Образ сайта: Caddy + наши статические файлы. Больше в нём нет НИЧЕГО.
#
# ⚠ ЭТО И ЕСТЬ ГЛАВНАЯ ЧИНИТЬ ДЫРЫ ЧАСТЬ, а не только сжатие. Раньше платформа
#   делала git-чекаут репозитория и отдавала каталог как есть — вместе с .git.
#   11.08.2026 проверено: https://grafik.one/.git/config открывался кодом 200 и
#   содержал ЖИВОЙ токен GitHub (ghu_…, право записи), а в этот репозиторий
#   платформа смотрит и выкатывает автоматически. Любой прохожий мог подменить
#   программу для всей клиники.
#
#   Здесь такого быть не может по устройству: в образ попадает только то, что
#   ниже перечислено в COPY. Каталога .git там нет вовсе.
#
# Версия Caddy закреплена намеренно: «latest» однажды приедет с несовместимой
# настройкой в момент, когда мы будем чинить что-то другое.
# ─────────────────────────────────────────────────────────────────────────────
FROM caddy:2.8-alpine

COPY Caddyfile /etc/caddy/Caddyfile

# Только файлы сайта. Перечислены поимённо, а не «COPY . .», чтобы новый файл
# рядом с репозиторием не уехал наружу сам собой.
COPY index.html manifest.json favicon.svg config.js /srv/
COPY app.js store.js sw.js styles.css /srv/
COPY icon-192.png icon-512.png icon-512-maskable.png apple-touch-icon.png /srv/
COPY vendor /srv/vendor

# Проверка при сборке: если файл потеряли, пусть сборка упадёт здесь, а не
# окажется 404 у людей. Заодно проверяем, что не затащили лишнего.
RUN test -s /srv/index.html && test -s /srv/app.js && test -s /srv/store.js \
 && test -s /srv/vendor/supabase.js \
 && test ! -e /srv/.git \
 && caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

EXPOSE 8080
